# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude
.claude/
nul

# typescript
*.tsbuildinfo
next-env.d.ts

# founder research tooling (third-party clone, fetched on demand)
/founder/.tools/

# design audit scratch output
/.hallmark/

# HyperFrames caches and per-project copies of the jingle
# (master copy: SMS_BUDDY/marketing/assets/audio/sms-buddy-jingle.wav; build_1111.py / build_howto.py copy it back in)
/videos/*/.hyperframes/
/videos/*/.thumbnails/
/videos/*/.waveform-cache/
/videos/*/snapshots*/
/videos/*/renders/
/videos/*/assets/audio/*.wav

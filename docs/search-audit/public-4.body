<!DOCTYPE html><!--mf5VNDz3U6PbuWfmQy9mq--><html lang="en" class="scroll-smooth"><head><meta charSet="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><link rel="preload" href="/_next/static/media/01ad422bcd0a01ad-s.p.ttf" as="font" crossorigin="" type="font/ttf"/><link rel="preload" href="/_next/static/media/6c596dfcddeca1e9-s.p.woff2" as="font" crossorigin="" type="font/woff2"/><link rel="preload" href="/_next/static/media/fedf4c9280b16369-s.p.woff2" as="font" crossorigin="" type="font/woff2"/><link rel="stylesheet" href="/_next/static/css/3e2c8dfa61c4c66e.css" data-precedence="next"/><link rel="stylesheet" href="/_next/static/css/828628b595539470.css" data-precedence="next"/><link rel="preload" as="script" fetchPriority="low" href="/_next/static/chunks/webpack-7dbd887d1a2e16f6.js"/><script src="/_next/static/chunks/4bd1b696-096d35a2bd1da3af.js" async=""></script><script src="/_next/static/chunks/794-37dad9bbc14b04b8.js" async=""></script><script src="/_next/static/chunks/main-app-753d8a8b89c42ffc.js" async=""></script><script src="/_next/static/chunks/500-5d45efbf86b8d36e.js" async=""></script><script src="/_next/static/chunks/app/layout-2900f7ecc18c0c9d.js" async=""></script><script src="/_next/static/chunks/384-705ba0841864e39e.js" async=""></script><script src="/_next/static/chunks/app/page-f2bb2cbb0e89751d.js" async=""></script><meta name="next-size-adjust" content=""/><title>SMS Buddy — Business SMS for Sri Lanka</title><meta name="description" content="SMS Buddy is a reliable, assisted SMS gateway for Sri Lankan businesses, agencies, and developers who need multi-brand, transactional and promotional messaging without long-term subscriptions."/><meta property="og:title" content="SMS Buddy"/><meta property="og:description" content="SMS Buddy is a reliable, assisted SMS gateway for Sri Lankan businesses, agencies, and developers who need multi-brand, transactional and promotional messaging without long-term subscriptions."/><meta property="og:url" content="https://smsbuddy.lk"/><meta property="og:site_name" content="SMS Buddy"/><meta property="og:type" content="website"/><meta name="twitter:card" content="summary"/><meta name="twitter:title" content="SMS Buddy"/><meta name="twitter:description" content="SMS Buddy is a reliable, assisted SMS gateway for Sri Lankan businesses, agencies, and developers who need multi-brand, transactional and promotional messaging without long-term subscriptions."/><link rel="icon" href="/favicon.ico?9f2a70bc6c15215f" type="image/x-icon" sizes="16x16"/><link rel="icon" href="/icon.svg?6fef986e659fabe2" type="image/svg+xml" sizes="any"/><script src="/_next/static/chunks/polyfills-42372ed130431b0a.js" noModule=""></script></head><body class="__variable_207d67 __variable_53f2d8 __variable_8dd2fb __variable_39d03d bg-background text-text font-body antialiased"><div hidden=""><!--$--><!--/$--></div><script type="application/json" id="smsbuddy-design-contract">{"THESIS":"Make business SMS tangible beside a direct account-creation CTA.","OWN_WORLD":"Cobalt retail-sign typography, white canvas, pale sky messaging workspace, flat geometric controls.","STORY":"Understand the offer, preview a message, learn setup and credit conditions, create an account.","FIRST_VIEWPORT":"Centered headline and signup action above a full-width interactive composer and realistic recipient phone.","FORM":"Retail window signage translated into a messaging workspace, candidate 3, seed 55f202a5.","FINISH":"unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md"}</script><a class="sb-skip-link" href="#main-content">Skip to content</a><header class="sb-header"><nav class="sb-shell sb-nav" aria-label="Main navigation"><a aria-label="SMS Buddy home" href="/"><span class="sb-brand"><svg viewBox="0 0 72 88" width="36" height="36" fill="none" aria-hidden="true"><path d="M10 4H42C55 4 64 13 64 25C64 32 61 37 56 40C63 43 67 49 67 57C67 69 57 76 43 76H19L8 83C6 84 4 83 4 80V10C4 7 7 4 10 4ZM21 27C15 27 12 31 12 37V58C12 60 14 61 16 59L23 54H37C45 54 49 48 49 41C49 33 44 27 37 27Z" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"></path></svg><span>SMS Buddy</span></span></a><div class="sb-nav-links"><a href="/features">Product</a><a href="/pricing">Pricing</a><a href="/for-agencies">For agencies</a><a href="/for-developers">For developers</a></div><div class="sb-nav-actions"><a class="sb-login" href="https://portal.smsbuddy.lk">Log in</a><a class="sb-primary sb-nav-cta" href="https://portal.smsbuddy.lk/register" data-cta-location="header">Get Started <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a><button class="sb-menu-toggle" aria-expanded="false" aria-controls="mobile-navigation" aria-label="Open navigation"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path></svg></button></div></nav></header><div class="min-h-screen"><main id="main-content" class="sb-home"><section class="sb-hero" aria-labelledby="hero-heading"><div class="sb-shell sb-hero-grid"><div class="sb-hero-copy"><h1 id="hero-heading"><span class="sb-headline-line">Your next customer</span> <span class="sb-headline-line">connection starts with a <span class="sb-text-word">text.</span></span></h1><p class="sb-hero-description">Send promotions, order updates and OTPs with your own brand name. Built for businesses in Sri Lanka.</p><div class="sb-hero-actions"><a href="https://portal.smsbuddy.lk/register" class="sb-primary" data-cta-location="hero">Get Started <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a><a href="#message-demo" class="sb-text-link"><span class="sb-play"><svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path d="m6 3 7 5-7 5Z" fill="currentColor"></path></svg></span>Try a message</a></div><p class="sb-reassurance">No monthly subscription <span>·</span> Local setup support</p></div><div class="sb-demo-stage" id="message-demo"><div class="sb-demo-caption"><span>Your brand. Their inbox.</span><span class="sb-demo-instruction">Make it yours. Preview the connection.</span></div><div class="sb-composer"><div class="sb-composer-top"><span class="sb-example-dot"></span>Interactive example</div><div class="sb-demo-tabs" role="group" aria-label="Message type"><button type="button" aria-pressed="false"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h14a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H9l-6 3V6a2 2 0 0 1 2-2Z"></path><path d="M7 9h10M7 13h6"></path></svg>Promotions</button><button type="button" aria-pressed="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3 9 5v9l-9 5-9-5V8l9-5Z"></path><path d="m3 8 9 5 9-5M12 13v9M7 6l10 5"></path></svg>Order updates</button><button type="button" aria-pressed="false"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3"></path></svg>OTP</button></div><form><label for="demo-sender">Sender name</label><input id="demo-sender" maxLength="11" autoComplete="off" spellCheck="false" value="YOUR BRAND"/><label for="demo-message">Your message</label><textarea id="demo-message" maxLength="400" required="" rows="4">Your order is ready. Thank you for shopping with us! Visit our store to collect it today.</textarea><div class="sb-demo-meta"><span>Try it with your business name</span><span>89<!-- --> characters</span></div><button type="submit" class="sb-primary">Preview message <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></button></form></div><div class="sb-message-transfer" aria-hidden="true"><svg viewBox="0 0 80 80" fill="none"><path d="M1 40h72m-9-9 10 9-10 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg><span style="opacity:0.4;transform:translateX(-12px)"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h14a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H9l-6 3V6a2 2 0 0 1 2-2Z"></path><path d="M7 9h10M7 13h6"></path></svg></span></div><div class="sb-inbox"><svg class="sb-phone-frame" viewBox="0 0 320 660" fill="none" aria-hidden="true"><defs><linearGradient id="_R_68inrb_-rim" x1="8" y1="0" x2="312" y2="660" gradientUnits="userSpaceOnUse"><stop stop-color="#a6abb4"></stop><stop offset=".16" stop-color="#353940"></stop><stop offset=".48" stop-color="#747a84"></stop><stop offset=".76" stop-color="#282b31"></stop><stop offset="1" stop-color="#8b919b"></stop></linearGradient><linearGradient id="_R_68inrb_-lens" x1="194" y1="24" x2="202" y2="34" gradientUnits="userSpaceOnUse"><stop stop-color="#25364c"></stop><stop offset="1" stop-color="#080b12"></stop></linearGradient></defs><g fill="#4b5059"><rect x="3" y="112" width="6" height="25" rx="2"></rect><rect x="2" y="156" width="7" height="49" rx="2"></rect><rect x="2" y="218" width="7" height="49" rx="2"></rect><rect x="311" y="178" width="7" height="77" rx="2"></rect></g><path fill="url(#_R_68inrb_-rim)" fill-rule="evenodd" d="M57 1H263A49 49 0 0 1 312 50V610A49 49 0 0 1 263 659H57A49 49 0 0 1 8 610V50A49 49 0 0 1 57 1ZM58 14A39 39 0 0 0 19 53V607A39 39 0 0 0 58 646H262A39 39 0 0 0 301 607V53A39 39 0 0 0 262 14Z"></path><rect x="11" y="4" width="298" height="652" rx="46" stroke="#121418" stroke-width="5"></rect><rect x="18" y="13" width="284" height="634" rx="40" stroke="#07080a" stroke-width="3"></rect><path d="M15 76V51C15 26 32 8 58 8H99M306 583V609C306 634 289 652 263 652H227" stroke="#d9dce2" stroke-opacity=".55" stroke-width="1.2" stroke-linecap="round"></path><g stroke="#b0b5bf" stroke-width="2" opacity=".6"><path d="M8 86H15M305 86H312M8 570H15M305 570H312"></path></g><rect x="113" y="24" width="94" height="26" rx="13" fill="#08090b"></rect><circle cx="194" cy="37" r="6" fill="#131923"></circle><circle cx="194" cy="37" r="3.7" fill="url(#_R_68inrb_-lens)"></circle><circle cx="192.8" cy="35.7" r="1" fill="#596a93" opacity=".7"></circle><rect x="115" y="632" width="90" height="4" rx="2" fill="#15171b"></rect></svg><div class="sb-phone-screen"><div class="sb-inbox-chrome"><span>9:41</span><svg viewBox="0 0 40 14" width="40" height="14" fill="currentColor" aria-hidden="true"><path d="M0 10h3v3H0zm5-3h3v6H5zm5-3h3v9h-3zm5-3h3v12h-3z"></path><rect x="24" y="3" width="12" height="8" rx="1"></rect><path d="M38 5h2v4h-2z"></path></svg></div><div class="sb-inbox-sender"><svg class="sb-phone-back" width="12" height="20" viewBox="0 0 12 20" fill="none" aria-hidden="true"><path d="m10 2-8 8 8 8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path></svg><span class="sb-recipient-avatar"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h14a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H9l-6 3V6a2 2 0 0 1 2-2Z"></path><path d="M7 9h10M7 13h6"></path></svg></span><strong>YOUR BRAND</strong><span>Text message · SMS</span></div><div class="sb-inbox-content" role="region" aria-label="Message preview" tabindex="0" aria-live="polite" aria-atomic="true"><span class="sb-inbox-time">Today, 9:41 AM</span><div class="sb-sms" style="opacity:0.5;clip-path:inset(0 0 12% 0 round 12px);transform:translateY(12px)">Your order is ready. Thank you for shopping with us! Visit our store to collect it today.</div><span class="sb-delivery"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6"></path></svg> Example preview</span></div><div class="sb-inbox-bottom"><svg width="17" height="17" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 3v14M3 10h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg><span>Text message <svg width="10" height="14" viewBox="0 0 10 14" fill="none" aria-hidden="true"><rect x="3" y="1" width="4" height="7" rx="2" stroke="currentColor"></rect><path d="M1 6v1a4 4 0 0 0 8 0V6M5 11v2" stroke="currentColor" stroke-linecap="round"></path></svg></span></div></div></div><p class="sb-demo-disclaimer">A live preview, not an actual SMS. Nothing is sent.</p></div><div class="sb-film-entry"><button type="button" class="sb-text-link" aria-haspopup="dialog"><span class="sb-play" aria-hidden="true"><svg viewBox="0 0 16 16" width="13" height="13"><path d="m6 3 7 5-7 5Z" fill="currentColor"></path></svg></span>Watch SMS Buddy in 15 seconds</button><dialog class="sb-film-dialog" aria-labelledby="sb-film-title"><div class="sb-film-panel"><div class="sb-film-heading"><h2 id="sb-film-title">Small messages. Stronger connections.</h2><button type="button" aria-label="Close video"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.8"></path></svg></button></div></div></dialog></div></div></section><div class="sb-shell sb-benefit-strip"><div><span class="sb-benefit-icon"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h14a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H9l-6 3V6a2 2 0 0 1 2-2Z"></path><path d="M7 9h10M7 13h6"></path></svg></span><span><strong>Bring customers back</strong><small>Share offers and announcements</small></span></div><div><span class="sb-benefit-icon"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3 9 5v9l-9 5-9-5V8l9-5Z"></path><path d="m3 8 9 5 9-5M12 13v9M7 6l10 5"></path></svg></span><span><strong>Keep people in the loop</strong><small>Send order and service updates</small></span></div><div><span class="sb-benefit-icon"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3"></path></svg></span><span><strong>Connect your application</strong><small>Deliver OTPs and notifications</small></span></div></div><section class="sb-section sb-sky" id="product"><div class="sb-shell"><div class="sb-section-intro" data-reveal="true"><h2>One platform.<br/><span>Every kind of message.</span></h2><p>A promotion worth opening. An update someone’s waiting for. A code that gets them in. Make every message useful.</p></div><div class="sb-use-cases" data-reveal="true"><article><div class="sb-use-visual sb-promo-visual"><div class="sb-mini-message"><span>YOUR STORE</span><p>Your weekend plans? A little something from us. Discover our new arrivals in store.</p><small>Illustrative message</small></div><span class="sb-message-tag">A reason to come back</span></div><h3>Turn “maybe later” into a visit.</h3><p>Put offers, launches and announcements in your customers’ inboxes. Start with people who have opted in to hear from you.</p><a class="sb-text-link" href="/for-smes">SMS for your business <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a></article><article><div class="sb-use-visual sb-order-visual"><div class="sb-order-ticket"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3 9 5v9l-9 5-9-5V8l9-5Z"></path><path d="m3 8 9 5 9-5M12 13v9M7 6l10 5"></path></svg><strong>Ready for collection</strong><p>One helpful update.<br/>One less “where’s my order?”</p><span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6"></path></svg> Example order notification</span></div></div><h3>Keep the next step clear.</h3><p>Send useful order updates and service notifications, so customers know what’s happening with your business.</p><a class="sb-text-link" href="/features">Explore the platform <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a></article><article><div class="sb-use-visual sb-otp-visual"><div class="sb-otp-title"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3"></path></svg> Verification code</div><div class="sb-otp-digits" aria-label="Example code 482916"><span>4</span><span>8</span><span>2</span><span>9</span><span>1</span><span>6</span></div><p>For the moments that need a code.</p><small>Illustrative OTP</small></div><h3>Make messaging part of your app.</h3><p>Connect SMS to your product for verification codes and transactional notifications through the API.</p><a class="sb-text-link" href="/for-developers">For developers <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a></article></div></div></section><section class="sb-section" id="how-it-works"><div class="sb-shell sb-steps-layout" data-reveal="true"><div><h2>From your business<br/>to their inbox.</h2><p class="sb-lead">A clear way to get started.<br/>And a local team when you need a hand.</p><a class="sb-primary" href="https://portal.smsbuddy.lk/register" data-cta-location="how_it_works">Get Started <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a></div><ol class="sb-steps"><li><span>1</span><div><h3>Create your account</h3><p>Add your business and contact details, then verify your email in the SMS Buddy portal.</p></div></li><li><span>2</span><div><h3>Get your sender name ready</h3><p>Apply for your business’s sender name. We can guide you through the approval requirements.</p></div></li><li><span>3</span><div><h3>Add credits. Start connecting.</h3><p>Choose credits for your needs, then send through the portal or connect your app with the API.</p></div></li></ol></div></section><section class="sb-section sb-brand-section"><div class="sb-shell sb-brand-layout" data-reveal="true"><div class="sb-agency-network" role="img" aria-label="Example: one SMS Buddy credit pool connects three approved brand sender names"><svg viewBox="0 0 520 400" fill="none" aria-hidden="true"><circle cx="260" cy="200" r="168" stroke="#334970"></circle><circle cx="260" cy="200" r="110" stroke="#334970"></circle><g stroke="#7596df" stroke-width="1.5"><path d="M260 160V78H118"></path><path d="M304 200H406V118"></path><path d="M260 242V327H366"></path></g><g fill="#b5ccff"><circle class="sb-network-dot" cx="183" cy="78" r="4"></circle><circle class="sb-network-dot" cx="406" cy="160" r="4"></circle><circle class="sb-network-dot" cx="300" cy="327" r="4"></circle></g><rect x="214" y="154" width="92" height="92" rx="24" fill="#244ceb"></rect><path d="M10 4H42C55 4 64 13 64 25C64 32 61 37 56 40C63 43 67 49 67 57C67 69 57 76 43 76H19L8 83C6 84 4 83 4 80V10C4 7 7 4 10 4ZM21 27C15 27 12 31 12 37V58C12 60 14 61 16 59L23 54H37C45 54 49 48 49 41C49 33 44 27 37 27Z" transform="translate(238 172) scale(.65)" fill="white" fill-rule="evenodd"></path><g font-family="var(--font-body), sans-serif" text-anchor="middle" font-weight="600" font-size="12" fill="#edf3ff"><rect x="28" y="53" width="128" height="50" rx="12" fill="#21355d"></rect><text x="92" y="83">YOUR STORE</text><rect x="348" y="71" width="142" height="50" rx="12" fill="#21355d"></rect><text x="419" y="101">YOUR STUDIO</text><rect x="342" y="302" width="146" height="50" rx="12" fill="#21355d"></rect><text x="415" y="332">YOUR NEXT BRAND</text></g></svg><div class="sb-network-caption"><strong>One account. One credit pool.</strong><span>Illustrative setup · Approved sender names</span></div></div><div><h2>More brands.<br/>Less back and forth.</h2><p class="sb-lead">Running campaigns for several businesses? Keep your approved sender names together and use one shared credit pool across your brands.</p><a class="sb-text-link" href="/for-agencies">Built for agencies, too <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a></div></div></section><section class="sb-section"><div class="sb-shell sb-credit-section"><div><h2>Buy credits.<br/>Skip the subscription.</h2><p class="sb-lead">Choose a pack that fits the messages you plan to send. Your credits stay valid for 3 months from purchase.</p><a class="sb-text-link" href="/pricing">Explore credit packs <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a></div><div class="sb-credit-facts"><div><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6"></path></svg><span><strong>No monthly subscription</strong><p>Top up when your business needs to send.</p></span></div><div><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6"></path></svg><span><strong>3-month credit validity</strong><p>Choose a pack you can use within that period.</p></span></div><div><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6"></path></svg><span><strong>One pool for your sender names</strong><p>Share credits across your approved brands.</p></span></div><p class="sb-small-note">Check current rates and applicable charges before purchasing. Longer messages may use more than one credit.</p></div></div></section><section class="sb-section sb-faq-section"><div class="sb-shell sb-faq-layout"><div><h2>A few things<br/>you might be asking.</h2><p class="sb-lead">Still have a question?</p><a class="sb-text-link" href="https://wa.me/94771172031">Talk to the local team <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a></div><div class="sb-faq"><details><summary>What happens after I click Get Started?<span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5v14"></path></svg></span></summary><p>You’ll open the SMS Buddy registration page. Enter your contact and business details, including your address, then verify your email. Our team can guide you through sender-name setup and your first messages.</p></details><details><summary>Do I need a monthly subscription?<span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5v14"></path></svg></span></summary><p>SMS Buddy uses prepaid credits rather than a monthly subscription. Buy credits when you need them and use them within 3 months. Confirm the current package price and any applicable charges before you buy.</p></details><details><summary>Will messages show my business name?<span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5v14"></path></svg></span></summary><p>You can apply for a branded sender name, also called a sender ID or mask. Sender names need approval before use. The team can help with the registration requirements.</p></details><details><summary>Can I use SMS Buddy without writing code?<span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5v14"></path></svg></span></summary><p>Use the portal for business messaging. If you’re connecting an application, explore the API integration options with our team.</p></details><details><summary>Can I manage more than one brand?<span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5v14"></path></svg></span></summary><p>SMS Buddy’s shared credit pool lets you use credits across your account’s approved sender names. It’s useful for teams and agencies working with multiple brands.</p></details><details><summary>Can you help me get set up?<span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5v14"></path></svg></span></summary><p>Yes. Contact the local team for help with your account, sender-name registration and integration questions. You can get started with an account or speak to us first.</p></details></div></div></section><section class="sb-final-section"><svg class="sb-final-mark" viewBox="0 0 72 88" fill="none" aria-hidden="true"><path d="M10 4H42C55 4 64 13 64 25C64 32 61 37 56 40C63 43 67 49 67 57C67 69 57 76 43 76H19L8 83C6 84 4 83 4 80V10C4 7 7 4 10 4ZM21 27C15 27 12 31 12 37V58C12 60 14 61 16 59L23 54H37C45 54 49 48 49 41C49 33 44 27 37 27Z" fill="currentColor" fill-rule="evenodd"></path></svg><div class="sb-shell sb-final"><div><h2>Your customers are<br/>a message away.</h2><p>Make your next connection with SMS Buddy.</p></div><div><a href="https://portal.smsbuddy.lk/register" class="sb-primary sb-white-button" data-cta-location="final">Get Started <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a><span>Create your account in the SMS Buddy portal.</span></div></div></section></main><!--$--><!--/$--></div><footer class="sb-footer"><div class="sb-shell"><div class="sb-footer-top"><div><a aria-label="SMS Buddy home" href="/"><span class="sb-brand"><svg viewBox="0 0 72 88" width="36" height="36" fill="none" aria-hidden="true"><path d="M10 4H42C55 4 64 13 64 25C64 32 61 37 56 40C63 43 67 49 67 57C67 69 57 76 43 76H19L8 83C6 84 4 83 4 80V10C4 7 7 4 10 4ZM21 27C15 27 12 31 12 37V58C12 60 14 61 16 59L23 54H37C45 54 49 48 49 41C49 33 44 27 37 27Z" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"></path></svg><span>SMS Buddy</span></span></a><p>Small messages.<br/>Stronger connections.</p><span>Business SMS for Sri Lanka.</span></div><div><h2>Product</h2><a href="/features">Features</a><a href="/pricing">Pricing</a><a href="https://portal.smsbuddy.lk/register" data-cta-location="footer">Get Started</a></div><div><h2>Made for you</h2><a href="/for-smes">Small businesses</a><a href="/for-agencies">Agencies</a><a href="/for-developers">Developers</a></div><div><h2>Let’s talk</h2><a href="/contact">Contact the team</a><a href="https://wa.me/94771172031">Chat on WhatsApp</a><a href="https://portal.smsbuddy.lk">Log in to your account</a></div></div><div class="sb-footer-bottom"><span>© <!-- -->2026<!-- --> SMS Buddy</span><span>Made for the way your business connects.</span></div></div></footer><script src="/_next/static/chunks/webpack-7dbd887d1a2e16f6.js" id="_R_" async=""></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,"1:\"$Sreact.fragment\"\n2:I[2338,[\"500\",\"static/chunks/500-5d45efbf86b8d36e.js\",\"177\",\"static/chunks/app/layout-2900f7ecc18c0c9d.js\"],\"ConversionTracking\"]\n3:I[9418,[\"500\",\"static/chunks/500-5d45efbf86b8d36e.js\",\"177\",\"static/chunks/app/layout-2900f7ecc18c0c9d.js\"],\"Navbar\"]\n4:I[7121,[],\"\"]\n5:I[4581,[],\"\"]\na:I[7123,[],\"\"]\n:HL[\"/_next/static/media/01ad422bcd0a01ad-s.p.ttf\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/ttf\"}]\n:HL[\"/_next/static/media/6c596dfcddeca1e9-s.p